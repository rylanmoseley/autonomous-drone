    {
      "id": "indgfkBhfLkaeL2kWw2B9",
      "type": "text",
      "x": 11532.50595163681,
      "y": 8434.384585469392,
      "width": 419.5196533203125,
      "height": 650,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b53",
      "roundness": null,
      "seed": 100294129,
      "version": 1362,
      "versionNonce": 1733640792,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788181520113,
      "link": null,
      "locked": false,
      "text": "\"Controls\": flight controller / firmware\n    fcu firmware + carrier\n    flight logic\n    integration\n    comms, logging, and telemetry\n\"Flight\": motors + escs + rotors\n    pick motor\n    pick esc\n    pick rotors\n    custom esc?\n\"Sensors\":\n    imu, alt/height, possibly motor encoders\n    sensor selection\n    sensor hardware, filtering, reading\n\"Power\": battery + bms\n    battery selection\n    bms selection / board\n    charging system\n    power distribution\n\"Vision and Localization\":\n    vision processor, board\n    Shape detection\n    possibly SLAM localization?\n\"Chassis\":\n    integration w/ rest of systems\n    custom chassis",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\"Controls\": flight controller / firmware\n    fcu firmware + carrier\n    flight logic\n    integration\n    comms, logging, and telemetry\n\"Flight\": motors + escs + rotors\n    pick motor\n    pick esc\n    pick rotors\n    custom esc?\n\"Sensors\":\n    imu, alt/height, possibly motor encoders\n    sensor selection\n    sensor hardware, filtering, reading\n\"Power\": battery + bms\n    battery selection\n    bms selection / board\n    charging system\n    power distribution\n\"Vision and Localization\":\n    vision processor, board\n    Shape detection\n    possibly SLAM localization?\n\"Chassis\":\n    integration w/ rest of systems\n    custom chassis",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "9nXwyPACtUA-IMGgYntQn",
      "type": "text",
      "x": 11543.972873804747,
      "y": 8168.250073504474,
      "width": 537.9500122070312,
      "height": 125,
