[connection]
id=HEXAGON-flight-drone
uuid=a1b2c3d4-e5f6-47a8-9b0c-droneap00001
type=wifi
interface-name=wlan0
autoconnect=true
autoconnect-priority=100

[wifi]
mode=ap
ssid=HEXAGON-flight-drone
band=bg
channel=6

[wifi-security]
key-mgmt=wpa-psk
psk=rylaniscool

[ipv4]
method=shared
address1=192.168.4.1/24

[ipv6]
method=ignore
