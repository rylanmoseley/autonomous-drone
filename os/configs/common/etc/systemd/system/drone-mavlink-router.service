[Unit]
Description=Autonomous Drone MAVLink Telemetry Router and Proxy
After=network.target local-fs.target drone-tuning.service
Wants=network.target drone-tuning.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/drone
ExecStart=/opt/drone/scripts/start_mavlink_proxy.sh
Restart=always
RestartSec=2

# Scheduling
LimitRTPRIO=50
LimitMEMLOCK=infinity
CPUSchedulingPolicy=other
Nice=-5

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=drone-mavlink-router

[Install]
WantedBy=multi-user.target
