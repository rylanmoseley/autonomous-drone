<?xml version="1.0" standalone='no'?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<service-group>
  <name replace-wildcards="yes">Autonomous Drone Companion (%h)</name>
  
  <!-- Ground Control Web UI -->
  <service>
    <type>_http._tcp</type>
    <port>8080</port>
    <txt-record>path=/</txt-record>
    <txt-record>app=AutonomousDroneGCS</txt-record>
  </service>

  <!-- MAVLink UDP Telemetry -->
  <service>
    <type>_mavlink._udp</type>
    <port>14550</port>
    <txt-record>sysid=1</txt-record>
  </service>

  <!-- SSH Remote Shell -->
  <service>
    <type>_ssh._tcp</type>
    <port>22</port>
  </service>
</service-group>
